# ──────────────────────────────────────────────
# Academic Twin — Environment Variables
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database (Supabase or PlanetScale)
DATABASE_URL=postgresql://user:password@host:5432/academic_twin

# Google Gemini (free tier — swap for OpenAI at launch)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (uncomment at launch and remove GEMINI vars)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database — Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=academic-twin
PINECONE_ENVIRONMENT=us-east-1
# IMPORTANT: When creating your Pinecone index, set Dimensions to 768 (Gemini embeddings)
# At launch with OpenAI, change to 1536

# File Storage — Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# Optional: AWS S3 (alternative storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=academic-twin-docs
